{
  "name": "civiccube",
  "version": "0.1.0",
  "description": "Serverless civic deliberation and consensus platform",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute civiccube-db --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute civiccube-db --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute civiccube-db --remote --file=./seed.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.80.0"
  }
}
